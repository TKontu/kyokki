{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(which:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(sed -n:*)",
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git merge-base:*)",
      "Bash(git remote -v)",
      "Bash(git fetch origin)",
      "Bash(git pull origin *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create --title * --body *)",
      "Bash(gh pr comment * --body-file *)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(python -m ruff:*)",
      "Bash(mypy:*)",
      "Bash(python -m mypy:*)",
      "Bash(uvicorn:*)",
      "Bash(python -m uvicorn:*)",
      "Bash(pip list:*)",
      "Bash(pip show:*)",
      "Bash(pip freeze:*)",
      "Bash(poetry show:*)",
      "Bash(poetry env info:*)",
      "Bash(uv pip list:*)",
      "Bash(uv pip show:*)",
      "Bash(alembic history:*)",
      "Bash(alembic current:*)",
      "Bash(alembic heads:*)",
      "Bash(docker compose run --rm kyokki-api alembic history:*)",
      "Bash(docker compose run --rm kyokki-api alembic current:*)",
      "Bash(celery inspect:*)",
      "Bash(redis-cli INFO:*)",
      "Bash(redis-cli KEYS:*)",
      "Bash(redis-cli GET:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npm ci)",
      "Bash(npm ls:*)",
      "Bash(npx jest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
