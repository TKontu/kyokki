# Application
DEBUG=false

# Database
POSTGRES_SERVER=postgres
POSTGRES_USER=kyokki_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=kyokki

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Origins the API accepts browser requests from, comma-separated. The iPad reaches the
# frontend, which proxies /api to the backend, so the frontend's origin is the one needed.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API access tokens (AG1). Empty: /api is open to anyone on the LAN, as before.
# Set: every /api request needs "Authorization: Bearer <secret>" (the health probes stay open).
# Comma-separated name:scope:sha256hex entries, scope read or write (write implies read).
# Only the hash goes here. Generate an entry and its secret with
#   python -m app.core.api_tokens new ipad write     (secret for KYOKKI_PROXY_TOKEN)
#   python -m app.core.api_tokens new hermes write   (secret for the agent)
# (in the stack: docker compose run --rm kyokki-api python -m app.core.api_tokens new ...)
KYOKKI_API_TOKENS=
# The secret (not the hash) the frontend's Next server sends on every /api request it
# proxies (frontend/middleware.ts); read at runtime, never sent to the browser. Its entry
# (the "ipad" line above) must be in KYOKKI_API_TOKENS, or the iPad gets 401s once tokens
# are on. Next reads its own environment: for `npm run dev`, export it or put it in
# frontend/.env.local.
KYOKKI_PROXY_TOKEN=

# MinerU OCR Service
MINERU_BASE_URL=http://192.168.0.94:8008
MINERU_TIMEOUT=120
MINERU_LANG=latin
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false

# LLM Service (OpenAI-compatible chat completions; llama-swap gateway)
LLM_BASE_URL=http://192.168.0.94:9292/v1
LLM_API_KEY=ollama
# c2.* runs on the GPU Kyokki may use; c0.* is reserved for the operator's agent
LLM_MODEL=c2.muse-glimmer
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
# Seconds per receipt read (the first read and the one targeted re-read). Stacks set up
# before Q27 carry 180 here, which long receipts outgrow: raise it to 420 (docs/DEPLOY.md)
LLM_TIMEOUT=420
# Seconds per catalog estimate or product selection call: short answers, and "Re-estimate
# all" waits for them, so they get their own shorter limit
LLM_ESTIMATE_TIMEOUT=180
# xhigh, high, medium or low for Muse Glimmer; leave empty for models without that template argument
LLM_REASONING_STRENGTH=low

# Product icons (Q18): the model that draws each product's 48x48 SVG icon, in the background.
# qwen draws far better icons than muse-glimmer, but it is a second model on the c2 GPU, so the
# gateway may swap the receipt model out while an icon is drawn. c2.muse-glimmer avoids that.
ICON_MODEL=c2.qwen3.8-27b
ICON_TIMEOUT=600

# Whether the extraction prompt lists catalog names for the model to reuse. Measured on the
# 49-line fixture (docs/vLLM_MANUAL_TEST.md): dropping it keeps all 49 lines and generic names
# but costs ~10 of the 40 categories, so it stays on.
EXTRACTION_OFFERS_CATALOG=true

# Open Food Facts API
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org/api/v2

# Fuzzy matching
FUZZY_MATCH_THRESHOLD=80

# Receipt queue worker (python -m app.worker): idle wait between queue checks, and how long a
# receipt may stay "processing" before it is treated as failed and can be retried. Leave the
# window empty: it follows the per-receipt budget, OCR (MINERU_TIMEOUT) plus the larger of
# 3 x LLM_TIMEOUT and 2 x LLM_TIMEOUT + LLM_ESTIMATE_TIMEOUT, rounded up to minutes, + 5
# (28 minutes with the defaults); a smaller value is raised to it, so a slow but healthy
# read is never failed
RECEIPT_WORKER_POLL_SECONDS=2
RECEIPT_STALE_MINUTES=

# Telegram receipt drop-in bot (python -m app.telegram_bot). Leave the token empty to disable.
# Token from @BotFather. Send /start to the bot to learn your chat id, then allowlist it.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids the bot serves, e.g. 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=
# Telegram API root and getUpdates long-poll seconds; change only to point at a test double
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=50
