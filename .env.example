# Application
DEBUG=false

# Database
POSTGRES_SERVER=postgres
POSTGRES_USER=kyokki_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=kyokki

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Origins the API accepts browser requests from, comma-separated. The iPad reaches the
# frontend, which proxies /api to the backend, so the frontend's origin is the one needed.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MinerU OCR Service
MINERU_BASE_URL=http://192.168.0.94:8008
MINERU_TIMEOUT=120
MINERU_LANG=latin
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false

# LLM Service (OpenAI-compatible chat completions; llama-swap gateway)
LLM_BASE_URL=http://192.168.0.94:9292/v1
LLM_API_KEY=ollama
# c2.* runs on the GPU Kyokki may use; c0.* is reserved for the operator's agent
LLM_MODEL=c2.muse-glimmer
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=180
# xhigh, high, medium or low for Muse Glimmer; leave empty for models without that template argument
LLM_REASONING_STRENGTH=low

# Whether the extraction prompt lists catalog names for the model to reuse. Measured on the
# 49-line fixture (docs/vLLM_MANUAL_TEST.md): dropping it keeps all 49 lines and generic names
# but costs ~10 of the 40 categories, so it stays on.
EXTRACTION_OFFERS_CATALOG=true

# Open Food Facts API
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org/api/v2

# Fuzzy matching
FUZZY_MATCH_THRESHOLD=80

# Receipt queue worker (python -m app.worker): idle wait between queue checks, and how long a
# receipt may stay "processing" before it is treated as failed and can be retried
RECEIPT_WORKER_POLL_SECONDS=2
RECEIPT_STALE_MINUTES=10

# Telegram receipt drop-in bot (python -m app.telegram_bot). Leave the token empty to disable.
# Token from @BotFather. Send /start to the bot to learn your chat id, then allowlist it.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids the bot serves, e.g. 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=
# Telegram API root and getUpdates long-poll seconds; change only to point at a test double
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=50
