# Application
DEBUG=false

# Database
POSTGRES_SERVER=postgres
POSTGRES_USER=kyokki_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=kyokki

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Origins the API accepts browser requests from, comma-separated. The iPad reaches the
# frontend, which proxies /api to the backend, so the frontend's origin is the one needed.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API access tokens (AG1). Empty: /api is open to anyone on the LAN, as before.
# Set: every /api request needs "Authorization: Bearer <secret>" (the health probes stay open).
# Comma-separated name:scope:sha256hex entries, scope read or write (write implies read).
# Only the hash goes here. Generate an entry and its secret with
#   python -m app.core.api_tokens new ipad write     (secret for KYOKKI_PROXY_TOKEN)
#   python -m app.core.api_tokens new hermes write   (secret for the agent)
# (in the stack: docker compose run --rm kyokki-api python -m app.core.api_tokens new ...)
KYOKKI_API_TOKENS=
# The secret (not the hash) the frontend's Next server sends on every /api request it
# proxies (frontend/middleware.ts); read at runtime, never sent to the browser. Its entry
# (the "ipad" line above) must be in KYOKKI_API_TOKENS, or the iPad gets 401s once tokens
# are on. Next reads its own environment: for `npm run dev`, export it or put it in
# frontend/.env.local.
KYOKKI_PROXY_TOKEN=

# MinerU OCR Service
MINERU_BASE_URL=http://192.168.0.94:8008
MINERU_TIMEOUT=120
MINERU_LANG=latin
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false

# LLM Service (OpenAI-compatible chat completions; llama-swap gateway)
LLM_BASE_URL=http://192.168.0.94:9292/v1
# The llama-swap key (required since 2026-09-30: the gateway returns 401 without it on
# /v1/* and /api/*). Also sent on every ComfyUI request below; harmless if unchecked there.
LLM_API_KEY=<llama-swap key>
# c2.* runs on the GPU Kyokki may use; c0.* is reserved for the operator's agent
LLM_MODEL=c2.muse-glimmer
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
# Seconds per receipt read (the first read and the one targeted re-read). Stacks set up
# before Q27 carry 180 here, which long receipts outgrow: raise it to 420 (docs/DEPLOY.md)
LLM_TIMEOUT=420
# Seconds per catalog estimate or product selection call: short answers, and "Re-estimate
# all" waits for them, so they get their own shorter limit. Raised from 180 to 300
# (2026-09-30): the llama-swap gateway notice says a cold start now takes 2 to 5 minutes.
LLM_ESTIMATE_TIMEOUT=300
# xhigh, high, medium or low for Muse Glimmer; leave empty for models without that template argument
LLM_REASONING_STRENGTH=low

# ComfyUI (Q18-G1/G2): generates a flat icon for a food product with no exact emoji (the gap),
# in the background. Empty disables the client entirely and this is the switch: generation is
# off until it is set - the Kyokki server cannot reach the GPU host yet (ComfyUI is
# loopback-only on 192.168.0.94; a media-gateway is planned but not built). Never hardcode the
# host elsewhere.
COMFYUI_BASE_URL=
# Seconds for one render job overall. Never below 60; see app/core/config.py for timings.
COMFYUI_TIMEOUT=300
COMFYUI_POLL_INTERVAL=2
# Pixels a side the generated icon is stored at, downscaled from ComfyUI's fixed 1024x1024.
ICON_IMAGE_SIZE=256

# Whether the extraction prompt lists catalog names for the model to reuse. Measured on the
# 49-line fixture (docs/vLLM_MANUAL_TEST.md): dropping it keeps all 49 lines and generic names
# but costs ~10 of the 40 categories, so it stays on.
EXTRACTION_OFFERS_CATALOG=true

# Open Food Facts API
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org/api/v2

# Fuzzy matching
FUZZY_MATCH_THRESHOLD=80

# Receipt queue worker (python -m app.worker): idle wait between queue checks, and how long a
# receipt may stay "processing" before it is treated as failed and can be retried. Leave the
# window empty: it follows the per-receipt budget, OCR (MINERU_TIMEOUT) plus the larger of
# 3 x LLM_TIMEOUT and 2 x LLM_TIMEOUT + LLM_ESTIMATE_TIMEOUT, rounded up to minutes, + 5
# (28 minutes with the defaults); a smaller value is raised to it, so a slow but healthy
# read is never failed
RECEIPT_WORKER_POLL_SECONDS=2
RECEIPT_STALE_MINUTES=

# Watched folder receipt drop-in (python -m app.worker, docs/DEPLOY.md "Watched folder"): a
# phone or computer sync app (Syncthing, a network share, e-receipts saved from mail) drops
# files into this folder instead of uploading them. Empty disables the scan, which is the
# default. The worker reads them like uploads: same validation and duplicate check, then moves
# each file to processed/, duplicates/ or rejected/ (with a reason) inside this folder.
RECEIPT_WATCH_DIR=
# How often the folder is scanned.
RECEIPT_WATCH_POLL_SECONDS=10
# A file must be unchanged in size and mtime for this long before it is taken, so a sync still
# writing it is never read half-finished.
RECEIPT_WATCH_SETTLE_SECONDS=5

# E-mail receipts (python -m app.worker, docs/DEPLOY.md "E-mail receipts"): Finnish chains
# (K-Ruoka, S-kanava, Lidl Plus) send e-receipts by mail, usually as a PDF attachment, and the
# cook forwards them (or has them sent) to a dedicated mailbox; the worker reads them like
# uploads. Empty host disables the scan, which is the default.
RECEIPT_MAIL_HOST=
RECEIPT_MAIL_PORT=993
RECEIPT_MAIL_USER=
# The mailbox password (an app password on most providers, not the account password). Never
# logged.
RECEIPT_MAIL_PASSWORD=
# Folder polled for unseen mail, and the folder read mail is moved to (created if missing).
RECEIPT_MAIL_FOLDER=INBOX
RECEIPT_MAIL_PROCESSED_FOLDER=Kyokki/Processed
# How often the mailbox is polled.
RECEIPT_MAIL_POLL_SECONDS=300
# Comma list of exact addresses or @domains allowed to mail in a receipt. Required when
# RECEIPT_MAIL_HOST is set: left empty, the scan refuses to start (one ERROR in the worker's
# log) rather than accept mail from anyone who knows the address.
RECEIPT_MAIL_ALLOWED_SENDERS=

# Telegram receipt drop-in bot (python -m app.telegram_bot). Leave the token empty to disable.
# Token from @BotFather. Send /start to the bot to learn your chat id, then allowlist it.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids the bot serves, e.g. 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=
# Telegram API root and getUpdates long-poll seconds; change only to point at a test double
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=50
