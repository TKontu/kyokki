# Environment for docker-compose.prod.yml.
#
# Portainer (Stacks -> Add stack -> Repository): paste this list into the stack's
# "Environment variables" (Advanced mode accepts this file as-is), fill in the secrets, deploy.
# Locally: copy to stack.env and run
#   docker compose -f docker-compose.prod.yml --env-file stack.env up -d
#
# Only POSTGRES_PASSWORD is required; every other key has the default shown here.
# stack.env is git-ignored; never commit filled-in values.

# Images published by .github/workflows/images.yml (pin a sha tag to roll back)
KYOKKI_BACKEND_IMAGE=ghcr.io/tkontu/kyokki-backend:latest
KYOKKI_FRONTEND_IMAGE=ghcr.io/tkontu/kyokki-frontend:latest

# Published ports: the iPad opens FRONTEND_PORT, API_PORT is the backend directly
FRONTEND_PORT=17301
API_PORT=17300

# Application
DEBUG=false

# Database (the compose file defaults these; POSTGRES_PASSWORD has no default)
POSTGRES_SERVER=postgres
POSTGRES_USER=kyokki_user
POSTGRES_PASSWORD=
POSTGRES_DB=kyokki

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinerU OCR service on the homelab
MINERU_BASE_URL=http://192.168.0.94:8008
MINERU_TIMEOUT=120
# PaddleOCR language pack; "latin" covers Finnish characters
MINERU_LANG=latin
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false

# LLM service (OpenAI-compatible chat completions, e.g. the llama-swap gateway)
LLM_BASE_URL=http://192.168.0.94:9292/v1
LLM_API_KEY=ollama
# Pick the copy pinned to the GPU Kyokki may use (see the gateway's /v1/models)
LLM_MODEL=c2.muse-glimmer
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=180
# xhigh, high, medium or low for Muse Glimmer; leave empty for models without that template argument
LLM_REASONING_STRENGTH=low

# Open Food Facts API
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org/api/v2

# Fuzzy matching threshold (0-100)
FUZZY_MATCH_THRESHOLD=80

# Receipt queue worker (python -m app.worker): idle wait between queue checks, and how long a
# receipt may stay "processing" before it is treated as failed and can be retried
RECEIPT_WORKER_POLL_SECONDS=2
RECEIPT_STALE_MINUTES=10

# Telegram receipt drop-in bot (python -m app.telegram_bot). Leave the token empty to disable.
# Token from @BotFather. Send /start to the bot to learn your chat id, then allowlist it.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids the bot serves, e.g. 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=
# Telegram API root and getUpdates long-poll seconds; defaults are right for the real API
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=50

# CORS is not needed for the production stack: the frontend proxies /api/* to the
# backend on the same origin. Set this (comma-separated) only if a browser app on
# another origin must call the API directly.
ALLOWED_ORIGINS=
