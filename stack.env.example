# Production environment for docker-compose.prod.yml (env_file: stack.env).
# Copy to stack.env and fill in real values. stack.env is git-ignored; never commit it.
# Postgres/Redis hosts and ports are set by the compose file itself and can be left as-is.

# Application
DEBUG=false

# Database (POSTGRES_SERVER/USER/DB are overridden by docker-compose.prod.yml)
POSTGRES_SERVER=postgres
POSTGRES_USER=kyokki_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kyokki

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinerU OCR service on the homelab
MINERU_BASE_URL=http://<mineru-host>:8000
MINERU_TIMEOUT=
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false

# LLM service (OpenAI-compatible endpoint: vLLM or Ollama)
LLM_BASE_URL=http://<llm-host>:9003/v1
LLM_API_KEY=change-me
LLM_MODEL=qwen3-8B
LLM_TEMPERATURE=0.1

# Open Food Facts API
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org/api/v2

# Fuzzy matching threshold (0-100)
FUZZY_MATCH_THRESHOLD=80

# CORS: comma-separated browser origins that may call the API.
# Must include the frontend as the iPad reaches it, e.g. http://<LAN-IP>:17301
ALLOWED_ORIGINS=http://localhost:3000,http://<LAN-IP>:17301
