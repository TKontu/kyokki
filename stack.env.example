# Production environment for docker-compose.prod.yml (env_file: stack.env).
# Copy to stack.env and fill in real values. stack.env is git-ignored; never commit it.
# Postgres/Redis hosts and ports are set by the compose file itself and can be left as-is.

# Application
DEBUG=false

# Database (POSTGRES_SERVER/USER/DB are overridden by docker-compose.prod.yml)
POSTGRES_SERVER=postgres
POSTGRES_USER=kyokki_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kyokki

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinerU OCR service on the homelab
MINERU_BASE_URL=http://<mineru-host>:8000
MINERU_TIMEOUT=120
# PaddleOCR language pack; "latin" covers Finnish characters
MINERU_LANG=latin
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false

# LLM service (OpenAI-compatible chat completions, e.g. the llama-swap gateway)
LLM_BASE_URL=http://<llm-host>:9292/v1
LLM_API_KEY=change-me
LLM_MODEL=muse-glimmer
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=180
# xhigh, high, medium or low for Muse Glimmer; leave empty for models without that template argument
LLM_REASONING_STRENGTH=low

# Open Food Facts API
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org/api/v2

# Fuzzy matching threshold (0-100)
FUZZY_MATCH_THRESHOLD=80

# Telegram receipt drop-in bot (python -m app.telegram_bot). Leave the token empty to disable.
# Token from @BotFather. Send /start to the bot to learn your chat id, then allowlist it.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids the bot serves, e.g. 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=

# CORS is not needed for the production stack: the frontend proxies /api/* to the
# backend on the same origin. Set ALLOWED_ORIGINS (comma-separated) only if a browser
# app on another origin must call the API directly.
# ALLOWED_ORIGINS=http://localhost:3000
