# Settings for running the backend on a workstation: pytest, uvicorn, alembic and
# `python -m app.worker`. Copy to backend/.env and edit.
#
# app/core/config.py reads the repo-root .env first and then this file, so anything
# set here wins. Docker Compose reads the repo-root .env, never this one, which is
# why the hosts below are localhost rather than the compose service names.
#
# Unknown keys are ignored, so a legacy key left in either file is harmless.

# Database. The test suite appends _test to POSTGRES_DB and creates that database
# itself; it refuses to run against anything whose name does not end in _test.
POSTGRES_SERVER=localhost
POSTGRES_USER=kyokki_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=kyokki

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Origins the API accepts browser requests from, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API access tokens (AG1): name:scope:sha256hex, comma-separated; empty leaves /api open.
# `python -m app.core.api_tokens new NAME read|write` prints a secret and its entry. The
# test suite empties this for every test, so setting it here does not break pytest.
KYOKKI_API_TOKENS=

# External services. Defaults point at the homelab; override when it is unreachable.
MINERU_BASE_URL=http://192.168.0.94:8008
LLM_BASE_URL=http://192.168.0.94:9292/v1
LLM_API_KEY=ollama
LLM_MODEL=c2.muse-glimmer

# Telegram receipt drop-in bot. Leave the token empty to disable the bot; use a
# separate token from the deployed one, or the two instances fight over getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
